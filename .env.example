# Origen público del sitio. Mientras esté vacío, el sitio se sirve desde la URL
# de Vercel y sale en noindex (ver src/lib/site.ts): es un demo y no debe
# competir en Google con el sitio actual del cliente.
#
# Al entregar, definir con el dominio definitivo, sin barra final:
#   NEXT_PUBLIC_SITE_URL=https://www.equiposyequipos.com.co
NEXT_PUBLIC_SITE_URL=

# Google Analytics 4. Sin esto no se carga gtag y no se pide ninguna cookie de
# terceros; los eventos igual se mandan a Vercel Analytics.
NEXT_PUBLIC_GA_ID=
